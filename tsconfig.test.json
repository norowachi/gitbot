{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "ignoreDeprecations": "5.0",
    "types": ["vitest/globals"]
  },
  "include": [
    "src",
    "src/**/*.test.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
