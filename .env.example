# Your public-facing URL (no trailing slash). Set this as your bot's
# "Interactions Endpoint URL" in the Discord Developer Portal.
SITE_URL=https://gitbot.example.com

# MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/gitbot

# Redis connection URI (used for the autocomplete cache)
REDIS_URL=redis://localhost:6379

# Port to listen on (default: 5000)
PORT=5000

# Discord REST API URL – override only if you use a proxy
# DISCORD_API_URL=https://discord.com/api/v10

# Discord bot token (from the Discord Developer Portal → Bot)
DISCORD_APP_TOKEN=

# GitHub OAuth App credentials (optional – enables "Sign in with GitHub" flow)
# GITHUB_CLIENT_NAME=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# AES-256 encryption key — must be exactly 32 characters
ENCRYPTION_KEY=your-32-character-key-goes-here!!

# Log level: trace | debug | info | warn | error | fatal (default: info)
# LOG_LEVEL=info

# Admin API token — required to use POST /admin/* endpoints (hotplug, restart, sync).
# Leave unset to disable the admin API entirely.
# ADMIN_TOKEN=generate-a-strong-random-secret-here

# Modules directory (relative to cwd, default: dist/modules)
# Override if you deploy modules from a different location.
# MODULES_DIR=dist/modules

# Comma-separated Discord user IDs allowed to use /announce and other admin commands.
# e.g. ADMIN_DISCORD_IDS=123456789012345678,987654321098765432
ADMIN_DISCORD_IDS=
